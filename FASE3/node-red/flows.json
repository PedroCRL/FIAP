    {
        "id": "func",
        "type": "function",
        "z": "aba_cardioia",
        "name": "Processar leitura",
        "func": "    // Limites dos alertas (os mesmos do config.h do ESP32)\nconst LIMITES = { bpmAlto: 120, bpmBaixo: 50, tempAlta: 38, tempBaixa: 35 };\n\nconst d = msg.payload;\n\n// 1) Validação: a mensagem precisa ter os campos principais\nif (typeof d !== 'object' || d === null || !d.reading_id ||\n    typeof d.heart_rate !== 'number' || typeof d.temperature !== 'number') {\n    node.warn('Mensagem inválida descartada');\n    return null;\n}\n\n// 2) Mensagens duplicadas: guarda os últimos 500 ids recebidos\nlet ids = flow.get('ids') || [];\nif (ids.includes(d.reading_id)) {\n    node.warn('Mensagem duplicada ignorada: ' + d.reading_id);\n    return null;\n}\nids.push(d.reading_id);\nif (ids.length > 500) ids.shift();\nflow.set('ids', ids);\n\n// 3) Alertas\nlet alertas = [];\nif (d.heart_rate > LIMITES.bpmAlto) alertas.push('ALERTA: Frequência cardíaca acima do limite configurado.');\nif (d.heart_rate < LIMITES.bpmBaixo) alertas.push('ALERTA: Frequência cardíaca abaixo do limite configurado.');\nif (d.temperature > LIMITES.tempAlta) alertas.push('ALERTA: Temperatura acima do limite configurado.');\nif (d.temperature < LIMITES.tempBaixa) alertas.push('ALERTA: Temperatura abaixo do limite configurado.');\nconst situacao = alertas.length > 0 ? alertas.join(' ') : 'NORMAL: Parâmetros dentro dos limites definidos.';\n\n// 4) Contadores\nconst recebidos = (flow.get('recebidos') || 0) + 1;\nconst totalAlertas = (flow.get('totalAlertas') || 0) + (alertas.length > 0 ? 1 : 0);\nconst totalOffline = (flow.get('totalOffline') || 0) + (d.offline ? 1 : 0);\nflow.set('recebidos', recebidos);\nflow.set('totalAlertas', totalAlertas);\nflow.set('totalOffline', totalOffline);\n\n// 5) Dados para os textos da dashboard\nconst painel = {\n    paciente: d.patient_id,\n    ultima: new Date().toLocaleString('pt-BR'),\n    wifi: d.offline ? 'Conectado (enviando dados da fila)' : 'Conectado',\n    mqtt: 'Conectado',\n    dispositivo: 'Online',\n    umidade: d.humidity.toFixed(1) + ' %',\n    recebidos: recebidos,\n    alertas: totalAlertas,\n    offline: totalOffline\n};\n\n// 6) Notificação só quando a situação muda para alerta\nlet notificacao = null;\nif (situacao !== flow.get('situacao') && alertas.length > 0) {\n    notificacao = { payload: situacao };\n}\nflow.set('situacao', situacao);\n\nreturn [\n    { topic: 'BPM', payload: d.heart_rate },\n    { topic: 'Temperatura', payload: Math.round(d.temperature * 10) / 10 },\n    { topic: 'Umidade', payload: Math.round(d.humidity * 10) / 10 },\n    { payload: painel },\n    { payload: situacao, ui_update: { color: alertas.length > 0 ? '#d32f2f' : '#2e7d32' } },\n    notificacao\n];\n",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 160,
        "wires": [
